# Copia este archivo a ".env" y completa tus valores reales.
# El archivo ".env" NUNCA se sube a git (ya esta en .gitignore).

# ===== BASE DE DATOS =====
# Cadena de conexion a MongoDB (local o Atlas)
# Local:  mongodb://127.0.0.1:27017/nutrix
# Atlas:  mongodb+srv://usuario:password@cluster.mongodb.net/nutrix
MONGO_URI=mongodb://127.0.0.1:27017/nutrix

# ===== SEGURIDAD =====
# Clave secreta para firmar los tokens de sesion (JWT).
# IMPORTANTE: debe tener AL MENOS 32 caracteres y ser unica. Si es corta
# o es el valor de ejemplo, el servidor se NIEGA a arrancar.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-esto-por-un-secreto-largo-y-unico

# Origenes permitidos para las peticiones del navegador (CORS), separados por coma.
# En produccion, si la web y la API viven en el mismo dominio, no hace falta cambiarlo.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost,capacitor://localhost

# Puerto donde corre el servidor
PORT=3000

# ===== IA (opcional) - genera el plan con Claude =====
# Sin esta clave, "Generar plan" usa el motor de reglas determinístico
# (la app funciona igual, pero sin IA).
# ANTHROPIC_API_KEY=sk-ant-...

# ===== GOOGLE LOGIN (opcional) - iniciar sesion con Google =====
# Requiere crear un proyecto en https://console.cloud.google.com (Google OAuth Client ID)
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# ===== EMAIL (opcional) - para "olvide mi contrasena" =====
# Si no se configuran, en desarrollo el codigo de recuperacion se muestra por consola.
# Ejemplo con Gmail (necesitas una "contraseña de aplicación"):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tuemail@gmail.com
# SMTP_PASS=tu-contraseña-de-aplicacion
# MAIL_FROM="Nutrix <no-reply@nutrix.app>"
