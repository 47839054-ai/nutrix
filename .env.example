# Copia este archivo a ".env" y completa tus valores reales.
# El archivo ".env" NUNCA se sube a git (ya esta en .gitignore).

# Cadena de conexion a MongoDB (local o Atlas)
# Local:  mongodb://127.0.0.1:27017/nutrix
# Atlas:  mongodb+srv://usuario:password@cluster.mongodb.net/nutrix
MONGO_URI=mongodb://127.0.0.1:27017/nutrix

# Clave secreta para firmar los tokens de sesion (cualquier texto largo y random)
JWT_SECRET=cambiar-esto-por-un-secreto-largo-y-unico

# Puerto donde corre el servidor
PORT=3000

# EMAIL (opcional) - para "olvide mi contrasena".
# Si no se configuran, en desarrollo el codigo de recuperacion se muestra por consola.
# Ejemplo con Gmail (necesitas una "contraseña de aplicación"):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tuemail@gmail.com
# SMTP_PASS=tu-contraseña-de-aplicacion
# MAIL_FROM="Nutrix <no-reply@nutrix.app>"
